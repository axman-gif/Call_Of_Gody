; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Call Of Gody"
config/description="2D Top-Down Zombie Survival Shooter translated from C++17 raylib (CallOfRay) to Godot 4.7 C++ GDExtension with Vulkan Forward+."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/zombie_face_male.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[native_extensions]

paths=["res://call_of_gody.gdextension"]

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
